rules_version = '2';
// KampüsCepte — Yol arkadaşı güvenlik kuralları.
// Firebase konsolu → Firestore Database → Kurallar sekmesine olduğu gibi yapıştırılıp Yayınla'ya basılır.
// BU SÜRÜM: ilan vermek ve katılmak için SMS ile doğrulanmış numara zorunlu (sitede numara doğrulaması açıkken yayınlanır).
service cloud.firestore {
  match /databases/{db}/documents {

    function girisli() { return request.auth != null; }
    // Yol arkadaşı yalnızca Google hesabıyla (anonim oturum yetmez)
    function googleli() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function benimTurum() {
      return get(/databases/$(db)/documents/kullanicilar/$(request.auth.uid)).data.tur;
    }
    function kizYurtlari()   { return ['fethi-sekin', 'harput', 'izzetpasa', 'sare-ana']; }
    function erkekYurtlari() { return ['ahmet-kabakli', 'firat', 'omer-bilginoglu']; }
    function yurtTuruUyar(d) {
      return (d.yurtTur == 'kiz' && d.yurt in kizYurtlari())
          || (d.yurtTur == 'erkek' && d.yurt in erkekYurtlari());
    }
    function metin(s, en) { return s is string && s.size() <= en; }
    // Site yöneticisi (yol-arkadasi sayfasındaki YONETICI ile aynı e-posta)
    function yonetici() {
      return googleli() && request.auth.token.email == 'yunusemredemir051@gmail.com' && request.auth.token.email_verified == true;
    }
    // Sahte ilan nedeniyle süresiz banlananlar (hesap ve WhatsApp numarası)
    function banli() { return exists(/databases/$(db)/documents/engelliler/$(request.auth.uid)); }
    function numaraBanli(tel) { return exists(/databases/$(db)/documents/engelliTel/$(tel)); }
    // Hesaba SMS ile bağlanmış Türkiye cep numarası (+905xxxxxxxxx); iletişimde "905xxxxxxxxx" olarak saklanır
    function dogruTel() {
      return 'phone_number' in request.auth.token && request.auth.token.phone_number is string
          && request.auth.token.phone_number.matches('^[+]905[0-9]{9}$');
    }
    function benimTel() { return request.auth.token.phone_number.replace('^[+]', ''); }

    // Kullanıcının seçtiği yurt (kız / erkek ayrımı buradan gelir)
    match /kullanicilar/{uid} {
      allow read: if googleli() && request.auth.uid == uid;
      allow write: if googleli() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['yurt', 'tur'])
        && yurtTuruUyar({ 'yurt': request.resource.data.yurt, 'yurtTur': request.resource.data.tur });
      allow delete: if googleli() && request.auth.uid == uid;
    }

    match /yolculuklar/{id} {
      function sahip() { return googleli() && request.auth.uid == resource.data.sahipUid; }

            // İlanlar herkese açık ve isimsizdir (isim ve telefon yalnızca iletisim alt koleksiyonunda, grup içinde görünür)
      allow read: if true;

      allow create: if googleli() && !banli() && dogruTel() && !numaraBanli(benimTel())
        && request.resource.data.sahipUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['sahipUid', 'yurt', 'yurtTur', 'yon', 'yer', 'zaman', 'aranan', 'ucret', 'not', 'katilanlar', 'olusturma'])
        && yurtTuruUyar(request.resource.data)
        && request.resource.data.yurtTur == benimTurum()
        && request.resource.data.yon in ['gidis', 'donus']
        && request.resource.data.yer in ['otogar', 'havaalani']
        && request.resource.data.zaman is timestamp
        && request.resource.data.zaman > request.time - duration.value(1, 'h')
        && request.resource.data.zaman < request.time + duration.value(31, 'd')
        && request.resource.data.aranan is int && request.resource.data.aranan >= 1 && request.resource.data.aranan <= 3
        && request.resource.data.ucret is int && request.resource.data.ucret >= 0 && request.resource.data.ucret <= 5000
        && metin(request.resource.data.not, 120)
        && request.resource.data.katilanlar == [];

      allow update: if sahip()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aranan', 'not', 'zaman', 'ucret'])
          && request.resource.data.aranan is int && request.resource.data.aranan >= 1 && request.resource.data.aranan <= 3
          && metin(request.resource.data.not, 120)
        // katılma: listeye yalnızca kendini ekleyebilirsin, yer varsa
        || googleli() && !banli() && dogruTel() && !numaraBanli(benimTel()) && resource.data.yurtTur == benimTurum()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['katilanlar'])
          && !(request.auth.uid in resource.data.katilanlar)
          && request.auth.uid != resource.data.sahipUid
          && request.resource.data.katilanlar == resource.data.katilanlar.concat([request.auth.uid])
          && request.resource.data.katilanlar.size() <= resource.data.aranan
        // vazgeçme: listeden yalnızca kendini çıkarabilirsin
        || googleli()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['katilanlar'])
          && request.auth.uid in resource.data.katilanlar
          && request.resource.data.katilanlar.toSet() == resource.data.katilanlar.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.katilanlar.size() == resource.data.katilanlar.size() - 1;

      allow delete: if sahip() || yonetici();

      // Telefon numaraları: yalnızca ilan sahibi ve katılanlar birbirininkini görür
      match /iletisim/{uid} {
        function ilan() { return get(/databases/$(db)/documents/yolculuklar/$(id)).data; }
        function grupta() {
          return googleli() && (request.auth.uid == ilan().sahipUid || request.auth.uid in ilan().katilanlar);
        }
        allow read: if grupta() || yonetici();
        allow write: if grupta() && request.auth.uid == uid && !banli()
          && request.resource.data.keys().hasOnly(['ad', 'tel'])
          && metin(request.resource.data.ad, 40)
          && dogruTel() && request.resource.data.tel == benimTel()
          && !numaraBanli(request.resource.data.tel);
        allow delete: if googleli() && (request.auth.uid == uid || request.auth.uid == ilan().sahipUid) || yonetici();
      }
    }

    // Yemek menüsü değerlendirmeleri: beğeni/beğenmeme ve yorumlar (herkes okur, girişli kullanıcı yazar)
    match /menuler/{menu} {
      function menuGecerli() { return menu.matches('^[a-z0-9-]+_[0-9]{4}-[0-9]{2}-[0-9]{2}(_(kahvalti|aksam))?$'); }
      match /oylar/{uid} {
        allow read: if true;
        allow create, update: if girisli() && request.auth.uid == uid && menuGecerli()
          && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d in [1, -1];
        allow delete: if girisli() && request.auth.uid == uid;
      }
      match /yorumlar/{id} {
        allow read: if true;
        allow create: if girisli() && menuGecerli()
          && request.resource.data.keys().hasOnly(['uid', 'ad', 'metin', 'ust', 'zaman'])
          && request.resource.data.uid == request.auth.uid
          && metin(request.resource.data.ad, 40) && request.resource.data.ad.size() >= 2
          && metin(request.resource.data.metin, 500) && request.resource.data.metin.size() > 0
          && metin(request.resource.data.ust, 40)
          && request.resource.data.zaman == request.time;
        allow delete: if girisli() && resource.data.uid == request.auth.uid;
      }
    }

    // Ban listeleri: yalnızca yönetici yazar; kişi yalnızca kendi kaydını görebilir
    match /engelliler/{uid} {
      allow read: if googleli() && request.auth.uid == uid || yonetici();
      allow write: if yonetici();
    }
    match /engelliTel/{tel} {
      allow read, write: if yonetici();
    }

    // Şikâyetler: kullanıcılar yazar, yönetici okur ve siler
    match /sikayetler/{id} {
      allow read, delete: if yonetici();
      allow create: if girisli()
        && request.resource.data.keys().hasOnly(['ilan', 'neden', 'uid', 'zaman'])
        && request.resource.data.uid == request.auth.uid
        && metin(request.resource.data.neden, 300);
    }
  }
}
