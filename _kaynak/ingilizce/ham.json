{"1": {"items": [{"n": 1, "s": "“I’m from Japan. I’m ______.” cümlesini tamamlayınız.", "o": ["Japan", "Japanish", "Japanese", "Japanian", "Japans"]}, {"n": 2, "s": "Aşağıdaki ülke–milliyet eşleştirmelerinden hangisi yanlıştır?", "o": ["Spain – Spanish", "Germany – German", "France – Franch", "Italy – Italian", "China – Chinese"]}, {"n": 3, "s": "“______ you from Brazil?” boşluğa hangisi gelir?", "o": ["Am", "Is", "Are", "Be", "Do"]}, {"n": 4, "s": "“My brother ______ a teacher.” cümlesinde boşluğa hangisi gelir?", "o": ["am", "is", "are", "be", "aren’t"]}, {"n": 5, "s": "“Are you Turkish?” sorusuna verilecek doğru olumlu kısa cevap hangisidir?", "o": ["Yes, I’m.", "Yes, I am.", "Yes, you are.", "Yes, I is.", "Yes, am I."]}, {"n": 6, "s": "“She is not American.” cümlesinin kısaltılmış hâli hangisidir?", "o": ["She’s not American. / She isn’t American.", "She amn’t American.", "She aren’t American.", "She not American.", "She’sn’t American."]}, {"n": 7, "s": "Nereli olduğunu sormak için hangisi kullanılır?", "o": ["What are you from?", "Who are you from?", "Where are you from?", "Where is you from?", "How are you from?"]}, {"n": 8, "s": "Aşağıdaki cümlelerden hangisi dil bilgisi bakımından yanlıştır?", "o": ["We are students.", "They’re from Greece.", "I am Turkish.", "He are Italian.", "It’s a small country."]}, {"n": 9, "s": "Akşam ayrılırken söylenen ifade hangisidir?", "o": ["Good morning", "Good afternoon", "Good evening", "Good night", "Hello"]}, {"n": 10, "s": "“Nice to meet you.” ifadesine en uygun cevap hangisidir?", "o": ["I’m fine, thanks.", "Nice to meet you, too.", "Good night.", "Yes, I am.", "I’m from Turkey."]}, {"n": 11, "s": "“They ______ from Russia. They’re from Poland.” boşluğa hangisi gelir?", "o": ["isn’t", "aren’t", "am not", "not", "don’t"]}, {"n": 12, "s": "“He Japanese.” cümlesi neden yanlıştır?", "o": ["Japanese küçük harfle yazılmalı", "Yüklem görevini yapan be (is) eksik", "He yerine His olmalı", "Cümleye a eklenmeli", "Hata yoktur"]}, {"n": 13, "s": "Derste anlamadığınız bir kelimenin anlamını sormak için hangisini kullanırsınız?", "o": ["How do you spell it?", "What does “late” mean?", "Can you open your book?", "Where are you from?", "Work in pairs."]}, {"n": 14, "s": "“Can you repeat that, please?” ne demektir?", "o": ["Bunu heceler misiniz?", "Tekrar eder misiniz, lütfen?", "Bunu açar mısınız?", "Bunu yazar mısınız?", "Anlamıyorum."]}, {"n": 15, "s": "“I’m from Turkish.” cümlesindeki hata nedir?", "o": ["I’m yerine I am olmalı", "from’dan sonra ülke adı (Turkey) gelmeli", "Turkish küçük harfle yazılmalı", "Cümleye a eklenmeli", "Hata yoktur"]}, {"n": 16, "s": "Hangi kelime büyük harfle başlamalıdır?", "o": ["teacher", "city", "italian", "student", "country"]}], "key": {"1": 2, "2": 2, "3": 2, "4": 1, "5": 1, "6": 0, "7": 2, "8": 3, "9": 3, "10": 1, "11": 1, "12": 1, "13": 1, "14": 1, "15": 1, "16": 2}, "ac": {"1": "Japan → Japanese (-ese eki).", "2": "Doğrusu France – French (düzensiz).", "3": "you ile are kullanılır; soru olduğu için başa gelir.", "4": "My brother = he → is.", "5": "Olumlu kısa cevapta kısaltma yapılmaz.", "6": "is not → isn’t; ya da she’s not.", "8": "He ile is kullanılır: He is Italian.", "9": "Good night vedalaşmadır; Good evening karşılaşırken söylenir.", "11": "they ile olumsuz: aren’t.", "12": "İsim cümlesinde yüklemi be üstlenir: He is Japanese.", "13": "Excuse me, what does … mean?", "15": "from + ülke: I’m from Turkey. ya da I’m Turkish.", "16": "Milliyetler ve ülkeler büyük harfle başlar: Italian."}, "extras": [[1, 3, "Olumlu kısa cevapta kısaltma yapılmaz: Yes, I am. ✔ – Yes, I’m. ✘"], [1, 3, "Olumsuz kısa cevapta kısaltma kullanılır: No, I’m not. / No, she isn’t. / No, we aren’t."], [1, 3, "Soru yaparken fiil öznenin önüne geçer: You are Turkish. → Are you Turkish?"], [1, 3, "En sık yapılan hata: I ile am, he/she/it ile is, you/we/they ile are kullanılır. “I is”, “They is”, “He"], [1, 3, "are” yanlıştır. Ayrıca I am not’ın “amn’t” diye kısaltması yoktur: I’m not."], [1, 16, "1.5"]]}, "2": {"items": [{"n": 1, "s": "“She’s ______ engineer.” boşluğa hangisi gelir?", "o": ["a", "an", "the", "—", "some"]}, {"n": 2, "s": "Aşağıdakilerden hangisi doğrudur?", "o": ["I’m an teacher.", "He’s a actor.", "They’re doctors.", "We’re a students.", "She’s nurse."]}, {"n": 3, "s": "“a / an” kullanımı bakımından hangisi yanlıştır?", "o": ["an hour", "a university", "an IT worker", "a umbrella", "an old house"]}, {"n": 4, "s": "40 sayısının doğru yazılışı hangisidir?", "o": ["fourty", "forty", "fourteen", "fortty", "foruty"]}, {"n": 5, "s": "“thirteen” hangi sayıdır?", "o": ["3", "13", "30", "33", "31"]}, {"n": 6, "s": "“How old are you?” sorusunun doğru cevabı hangisidir?", "o": ["I have nineteen years.", "I’m nineteen.", "I nineteen.", "My age has nineteen.", "I’m nineteen years."]}, {"n": 7, "s": "Meslek sormak için hangisi kullanılır?", "o": ["What do you do?", "How do you do?", "Where do you do?", "What are you do?", "Who is your job?"]}, {"n": 8, "s": "“It’s a ______ car.” Hangisi boşluğa gelmez?", "o": ["new", "fast", "old", "cheap", "expensives"]}, {"n": 9, "s": "“The exam isn’t difficult. It’s ______.” boşluğa hangisi gelir?", "o": ["easy", "boring", "expensive", "slow", "bad"]}, {"n": 10, "s": "Formdaki “Surname” bölümüne ne yazılır?", "o": ["Ad", "Soyad", "Uyruk", "Meslek", "İmza"]}, {"n": 11, "s": "Formdaki “Nationality” bölümü için hangisi doğrudur?", "o": ["Turkey", "turkish", "Turkish", "Elazığ", "Türk"]}, {"n": 12, "s": "Tek başına “police” kelimesi ne anlama gelir?", "o": ["Kadın polis", "Polis teşkilatı", "Polis memuru", "Polis arabası", "Polis karakolu"]}, {"n": 13, "s": "Kadın garson için hangi kelime kullanılır?", "o": ["waiter", "waitress", "waitor", "waitwoman", "server man"]}, {"n": 14, "s": "Hangi sayıda vurgu sondadır ve uzatılarak söylenir?", "o": ["fifty", "forty", "sixteen", "seventy", "ninety"]}, {"n": 15, "s": "“old” sıfatının bir insan için kullanılan zıt anlamlısı hangisidir?", "o": ["new", "young", "small", "cheap", "happy"]}, {"n": 16, "s": "“twenty-five” rakamla nasıl yazılır?", "o": ["205", "25", "52", "215", "250"]}, {"n": 17, "s": "Hangi cümlede sıfat doğru yerdedir?", "o": ["She’s a teacher good.", "It’s a city big.", "My job is interesting.", "They’re cars fast.", "He’s doctor a good."]}], "key": {"1": 1, "2": 2, "3": 3, "4": 1, "5": 1, "6": 1, "7": 0, "8": 4, "9": 0, "10": 1, "11": 2, "12": 1, "13": 1, "14": 2, "15": 1, "16": 1, "17": 2}, "ac": {"1": "engineer sesli harf sesiyle başlar.", "2": "Çoğulda a/an kullanılmaz; tekilde mutlaka a/an gerekir.", "3": "umbrella sesli harf sesiyle başlar: an umbrella.", "4": "forty “u” almaz.", "5": "-teen = 13–19; -ty = onluklar.", "6": "Yaş be ile söylenir; “years old” ile kullanılabilir ama yalnız “years” eksik olur.", "7": "What do you do? / What’s your job?", "8": "Sıfatlar çoğul eki almaz.", "9": "difficult ↔ easy.", "11": "Milliyet büyük harfle: Turkish.", "12": "Kişi için police officer denir.", "14": "-teen’li sayılarda vurgu sondadır.", "15": "Eşya: old–new · İnsan: old–young.", "17": "Sıfat be’den sonra ya da isimden önce gelir."}, "extras": [[2, 2, "Formda isimler, soyadlar, ülkeler, milliyetler ve şehirler büyük harfle başlar. First name"], [2, 2, "= ad, surname = soyad; ikisi sınavlarda sıkça karıştırılır."], [2, 17, "2.6"]]}, "3": {"items": [{"n": 1, "s": "“______ are my glasses.” (elimdeki gözlükler) boşluğa hangisi gelir?", "o": ["This", "That", "These", "Those", "It"]}, {"n": 2, "s": "Uzaktaki tek bir nesne için hangisi kullanılır?", "o": ["this", "that", "these", "those", "they"]}, {"n": 3, "s": "Hangisi dil bilgisi bakımından doğrudur?", "o": ["This are my keys.", "Those is your bag.", "These books are new.", "That are my phone.", "These is my watch."]}, {"n": 4, "s": "“watch” kelimesinin çoğulu hangisidir?", "o": ["watchs", "watches", "watchies", "watchves", "watch"]}, {"n": 5, "s": "“city” kelimesinin çoğulu hangisidir?", "o": ["citys", "cities", "cityes", "citis", "citees"]}, {"n": 6, "s": "“key” kelime