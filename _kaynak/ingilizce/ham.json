, "10": "I = ay, E = i, A = ey.", "11": "-fe → -ves.", "12": "-x ile biten → -es.", "13": "Telefon numaraları rakam rakam; aynı iki rakam “double”.", "14": "Uzak + çoğul: those.", "15": "sunglasses her zaman çoğuldur.", "16": "a → e, -s almaz.", "18": "orange sesli harf sesiyle başlar."}, "extras": [[3, 2, "Renkler de sıfattır: ismin önüne gelir ve çoğul eki almaz: two red bags (two reds bags ✘)."], [3, 2, "Renkten önceki a/an, rengin sesine göre seçilir: an orange umbrella, a blue umbrella."], [3, 19, "3.7"]]}, "4": {"items": [{"n": 1, "s": "“This is Ahmet. ______ wife is a teacher.”", "o": ["Her", "His", "Its", "Their", "He’s"]}, {"n": 2, "s": "“Zeynep and her husband live in İzmir. ______ house is very big.”", "o": ["There", "They’re", "Their", "His", "Our"]}, {"n": 3, "s": "Hangisi doğrudur?", "o": ["This is my.", "Is that your?", "These are our books.", "It’s her.", "That’s their."]}, {"n": 4, "s": "“Annemin erkek kardeşi” İngilizcede nasıl ifade edilir?", "o": ["my mother brother", "my mother’s brother", "my brother’s mother", "my mothers brother", "mother’s my brother"]}, {"n": 5, "s": "“uncle” kelimesinin Türkçe karşılığı hangisidir?", "o": ["yalnızca amca", "yalnızca dayı", "amca ya da dayı", "kuzen", "dede"]}, {"n": 6, "s": "“______ bag is this? – It’s Selin’s.”", "o": ["Who", "Who’s", "Whose", "What", "Which’s"]}, {"n": 7, "s": "“My parents ______ car is red.” boşluğa hangisi gelir?", "o": ["’s", "’", "s", "is", "’re"]}, {"n": 8, "s": "“The dog is happy. ______ name is Max.”", "o": ["It’s", "Its", "His", "Her", "Their"]}, {"n": 9, "s": "“Ali’s tired.” cümlesindeki ’s neyi gösterir?", "o": ["İyelik", "is fiilinin kısaltması", "Çoğul eki", "has kısaltması", "Hiçbiri"]}, {"n": 10, "s": "“my father’s sister” Türkçede kimdir?", "o": ["teyze", "hala", "yenge", "kuzen", "anneanne"]}, {"n": 11, "s": "“We love ______ teacher. She’s great.”", "o": ["us", "we", "our", "ours", "their"]}, {"n": 12, "s": "Hangisi kumaş pantolon anlamına gelir?", "o": ["jeans", "trousers", "shorts", "shirt", "jacket"]}, {"n": 13, "s": "“purse” ne anlama gelir?", "o": ["sırt çantası", "kadın cüzdanı", "kredi kartı", "şemsiye", "anahtar"]}, {"n": 14, "s": "“Victoria Beckham’s sister” ifadesinde ’s neye karşılık gelir?", "o": ["-dır", "-ın / -nin iyelik eki", "-ler çoğul eki", "-de bulunma eki", "-e yönelme eki"]}], "key": {"1": 1, "2": 2, "3": 2, "4": 1, "5": 2, "6": 2, "7": 1, "8": 1, "9": 1, "10": 1, "11": 2, "12": 1, "13": 1, "14": 1}, "ac": {"1": "Sahip erkek → his.", "2": "Onların → their.", "3": "İyelik sıfatından sonra mutlaka isim gelir.", "6": "Kime ait: Whose.", "7": "-s ile biten çoğul: parents’.", "8": "Hayvan/cansız: its.", "9": "Arkasından sıfat geliyor: Ali is tired."}, "extras": [[4, 4, "İyelik bildiren ’s’teki s harfi isimlerden sonra çoğunlukla z gibi okunur: Amy’s (eymiz), Connor’s"], [4, 4, "(konırz). Ayrıca ’s her zaman iyelik değildir; She’s = she is olabilir. Cümledeki görevine bakın:"], [4, 4, "arkasından isim geliyorsa iyeliktir (Ali’s car), sıfat ya da isim cümlesi geliyorsa “is”tir (Ali’s"], [4, 4, "tired)."], [4, 14, "4.6"]]}, "5": {"items": [{"n": 1, "s": "“______ time is it?” boşluğa hangisi gelir?", "o": ["How", "What", "Which", "When", "Who"]}, {"n": 2, "s": "Saat 6:30 nasıl söylenir?", "o": ["It’s half to six.", "It’s half past six.", "It’s half past seven.", "It’s six and half.", "It’s thirty to six."]}, {"n": 3, "s": "Saat 8:15 nasıl söylenir?", "o": ["It’s quarter to eight.", "It’s quarter past eight.", "It’s fifteen to eight.", "It’s eight quarter.", "It’s half past eight."]}, {"n": 4, "s": "Saat 11:45 nasıl söylenir?", "o": ["It’s quarter past eleven.", "It’s quarter to eleven.", "It’s quarter to twelve.", "It’s half past eleven.", "It’s forty-five to twelve."]}, {"n": 5, "s": "Saat 3:00 nasıl söylenir?", "o": ["It’s three past.", "It’s three o’clock.", "It’s three hours.", "It’s o’clock three.", "It’s three half."]}, {"n": 6, "s": "“It’s ten to five.” saat kaçı gösterir?", "o": ["5:10", "4:50", "10:05", "4:10",